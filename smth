<script src="[cdn.jsdelivr.net](https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js)"></script>
<script>
async function downloadPPTX() {
    const btn = document.querySelector('button[onclick="downloadPPTX()"]');
    const originalHTML = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Exporteren...';
    btn.disabled = true;

    try {
        let pptx = new PptxGenJS();
        // True 16:9: 13.33 x 7.5 inches
        pptx.layout = 'LAYOUT_16x9';

        const C = {
            bg:         '0B1120',
            card:       '1A2744',
            accent:     '3B82F6',
            accentLight:'38BDF8',
            white:      'FFFFFF',
            muted:      '94A3B8',
            mutedDark:  '475569',
            success:    '34D399',
            error:      'FB7185',
        };
        const F = 'Segoe UI';
        const W = 13.33; // slide width
        const H = 7.5;   // slide height

        // ─── SLIDE MASTER ───────────────────────────────────────────────
        pptx.defineSlideMaster({
            title: 'DARK',
            background: { color: C.bg },
            objects: [
                { rect: { x: 0, y: H - 0.55, w: W, h: 0.55, fill: { color: C.bg } } },
                { line: { x: 0, y: H - 0.56, w: W, h: 0, line: { color: C.mutedDark, width: 0.5 } } },
                { text: {
                    text: 'Sint-Jozef Sint-Pieter Blankenberge',
                    options: { x: 0.5, y: H - 0.45, w: 5.5, h: 0.35,
                               fontFace: F, color: C.mutedDark, fontSize: 9, bold: true }
                }},
                { text: {
                    text: 'Begeleiders: B. Carreyn, V. De Klerck, D. Momballyu, C. Van Luchem',
                    options: { x: 6.5, y: H - 0.45, w: 6.33, h: 0.35,
                               fontFace: F, color: C.mutedDark, fontSize: 9, align: 'right' }
                }}
            ]
        });

        // ── helper: rounded card ─────────────────────────────────────────
        function card(slide, x, y, w, h, opts = {}) {
            slide.addShape(pptx.ShapeType.roundRect, {
                x, y, w, h,
                fill: { color: opts.fillColor || C.card },
                line: opts.border
                    ? { color: opts.border, width: opts.borderWidth || 1 }
                    : { type: 'none' },
                rectRadius: 0.12
            });
        }

        // ── helper: left-border accent strip (drawn ON TOP of card) ──────
        function accentBar(slide, x, y, h, color) {
            slide.addShape(pptx.ShapeType.roundRect, {
                x: x,
                y: y,
                w: 0.09,
                h: h,
                fill: { color },
                line: { type: 'none' },
                rectRadius: 0.04
            });
        }

        // ── helper: section label at top ─────────────────────────────────
        function sectionLabel(slide, text, subtext) {
            slide.addText(text, {
                x: 0.55, y: 0.38, w: W - 1.1, h: 0.5,
                fontFace: F, color: C.accentLight, fontSize: 22, bold: true
            });
            if (subtext) {
                slide.addText(subtext, {
                    x: 0.55, y: 0.85, w: W - 1.1, h: 0.35,
                    fontFace: F, color: C.accent, fontSize: 14, bold: true
                });
            }
        }

        // ════════════════════════════════════════════════════════════════
        // SLIDE 1 — TITELSLIDE
        // ════════════════════════════════════════════════════════════════
        let s1 = pptx.addSlide({ masterName: 'DARK' });

        // Main card
        card(s1, 0.65, 2.0, 10.2, 4.1);
        accentBar(s1, 0.65, 2.0, 4.1, C.accent);

        s1.addText('GEÏNTEGREERDE PROEF 2025-2026', {
            x: 1.05, y: 2.35, w: 9.5, h: 0.35,
            fontFace: F, color: C.accentLight, fontSize: 11, bold: true, charSpacing: 2
        });
        s1.addText('Welke studierichting\npast bij mij?', {
            x: 1.05, y: 2.78, w: 9.0, h: 1.5,
            fontFace: F, color: C.white, fontSize: 34, bold: true
        });
        // Underline divider
        s1.addShape(pptx.ShapeType.rect, {
            x: 1.05, y: 4.38, w: 1.8, h: 0.025,
            fill: { color: C.accent }, line: { type: 'none' }
        });
        s1.addText('[Jouw Voornaam & Naam]', {
            x: 1.05, y: 4.55, w: 9.0, h: 0.45,
            fontFace: F, color: C.white, fontSize: 20, bold: true
        });
        s1.addText('Klas 4BO', {
            x: 1.05, y: 5.05, w: 9.0, h: 0.32,
            fontFace: F, color: C.muted, fontSize: 13
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 2 — 01. PROFIEL & VOORSTELLING
        // ════════════════════════════════════════════════════════════════
        let s2 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s2, '01. Profiel & Voorstelling');

        // Photo placeholder (dashed border)
        s2.addShape(pptx.ShapeType.roundRect, {
            x: 0.55, y: 1.25, w: 4.6, h: 5.6,
            fill: { color: C.bg },
            line: { color: C.mutedDark, width: 1, dashType: 'dash' },
            rectRadius: 0.12
        });
        // Camera icon placeholder text
        s2.addText('📷', {
            x: 0.55, y: 3.5, w: 4.6, h: 0.6,
            fontFace: F, align: 'center', color: C.mutedDark, fontSize: 28
        });
        s2.addText('Jouw foto hier', {
            x: 0.55, y: 4.15, w: 4.6, h: 0.35,
            fontFace: F, align: 'center', color: C.mutedDark, fontSize: 12
        });

        // Info card (right)
        card(s2, 5.6, 1.25, 7.2, 5.6);

        s2.addText('WIE BEN IK?', {
            x: 6.1, y: 1.85, w: 6.3, h: 0.38,
            fontFace: F, color: C.white, fontSize: 15, bold: true, charSpacing: 1
        });

        const profileRows = [
            { label: 'Naam:', val: '[Jouw Naam]' },
            { label: 'Leeftijd:', val: '[Jouw Leeftijd] jaar' },
            { label: "Hobby's:", val: '[Sport 1], [Interesse 2]' },
            { label: 'Interesseveld:', val: 'Economie, digitalisering, ondernemerschap' }
        ];
        profileRows.forEach((row, i) => {
            let rowY = 2.55 + i * 0.72;
            // Arrow icon
            s2.addText('→', {
                x: 6.0, y: rowY, w: 0.35, h: 0.38,
                fontFace: F, color: C.accent, fontSize: 13
            });
            s2.addText([
                { text: row.label + ' ', options: { bold: true, color: C.white } },
                { text: row.val,         options: { bold: false, color: C.white } }
            ], {
                x: 6.35, y: rowY, w: 6.1, h: 0.38,
                fontFace: F, fontSize: 14
            });
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 3 — STERKTES & WERKPUNTEN
        // ════════════════════════════════════════════════════════════════
        let s3 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s3, 'Sterktes & Werkpunten');

        const buildSWCard = (slide, xPos, titleText, iconChar, strengths, weaknesses) => {
            const cW = 5.9, cH = 5.6, cY = 1.25;
            card(slide, xPos, cY, cW, cH);

            // Icon circle
            slide.addShape(pptx.ShapeType.ellipse, {
                x: xPos + (cW / 2) - 0.45, y: cY + 0.3, w: 0.9, h: 0.9,
                fill: { color: '1E3A5F' }, line: { type: 'none' }
            });
            slide.addText(iconChar, {
                x: xPos + (cW / 2) - 0.45, y: cY + 0.3, w: 0.9, h: 0.9,
                fontFace: F, align: 'center', valign: 'middle', color: C.accentLight, fontSize: 22
            });

            slide.addText(titleText, {
                x: xPos + 0.35, y: cY + 1.35, w: cW - 0.7, h: 0.4,
                fontFace: F, align: 'center', color: C.white, fontSize: 14, bold: true, charSpacing: 1
            });

            // + STERKTES
            slide.addText('+ STERKTES', {
                x: xPos + 0.35, y: cY + 1.9, w: cW - 0.7, h: 0.3,
                fontFace: F, color: C.success, fontSize: 11, bold: true
            });
            strengths.forEach((item, i) => {
                slide.addText('→  ' + item, {
                    x: xPos + 0.35, y: cY + 2.25 + i * 0.45, w: cW - 0.7, h: 0.35,
                    fontFace: F, color: C.white, fontSize: 13
                });
            });

            // — WERKPUNTEN
            let wkY = cY + 2.25 + strengths.length * 0.45 + 0.2;
            slide.addText('— WERKPUNTEN', {
                x: xPos + 0.35, y: wkY, w: cW - 0.7, h: 0.3,
                fontFace: F, color: C.error, fontSize: 11, bold: true
            });
            weaknesses.forEach((item, i) => {
                slide.addText('→  ' + item, {
                    x: xPos + 0.35, y: wkY + 0.38 + i * 0.45, w: cW - 0.7, h: 0.35,
                    fontFace: F, color: C.white, fontSize: 13
                });
            });
        };

        buildSWCard(s3, 0.55, 'OP SCHOOL', '🎓',
            ['Wiskundig inzicht', 'ICT vaardigheden'],
            ['Franse taalvakken', 'Aandacht bij lange theorie']
        );
        buildSWCard(s3, 6.88, 'BUITEN SCHOOL', '👥',
            ['Teamspeler (Sport)', 'Creatief problemen oplossen'],
            ['Persoonlijke planning']
        );

        // ════════════════════════════════════════════════════════════════
        // SLIDE 4 — REFLECTIE & MOTTO
        // ════════════════════════════════════════════════════════════════
        let s4 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s4, 'Reflectie & Motto');

        // Left top: Leuk & Interessant
        card(s4, 0.55, 1.25, 6.0, 2.3);
        accentBar(s4, 0.55, 1.25, 2.3, C.success);
        s4.addText('Leuk & Interessant', {
            x: 0.95, y: 1.45, w: 5.3, h: 0.4,
            fontFace: F, color: C.white, fontSize: 15, bold: true
        });
        s4.addText('Praktijkgerichte projecten, resultaten zien, actieve betrokkenheid.', {
            x: 0.95, y: 1.9, w: 5.3, h: 1.0,
            fontFace: F, color: C.muted, fontSize: 13
        });

        // Left bottom: Liever Niet
        card(s4, 0.55, 3.8, 6.0, 2.3);
        accentBar(s4, 0.55, 3.8, 2.3, C.error);
        s4.addText('Liever Niet', {
            x: 0.95, y: 4.0, w: 5.3, h: 0.4,
            fontFace: F, color: C.white, fontSize: 15, bold: true
        });
        s4.addText('Puur theoretisch blokwerk zonder link naar de realiteit.', {
            x: 0.95, y: 4.45, w: 5.3, h: 1.0,
            fontFace: F, color: C.muted, fontSize: 13
        });

        // Right: Quote box
        card(s4, 6.88, 1.25, 5.9, 4.85);

        // Big quote mark
        s4.addText('\u201C', {
            x: 7.1, y: 1.3, w: 1.0, h: 0.9,
            fontFace: F, color: '1E3A5F', fontSize: 60, bold: true
        });
        s4.addText('"Fouten zijn het bewijs dat je het probeert."', {
            x: 7.2, y: 2.35, w: 5.3, h: 1.7,
            fontFace: F, color: C.white, fontSize: 22, bold: true, italic: true, align: 'center'
        });
        s4.addShape(pptx.ShapeType.rect, {
            x: 9.0, y: 4.15, w: 2.0, h: 0.03,
            fill: { color: C.accent }, line: { type: 'none' }
        });
        s4.addText('Gekozen omdat motivatie en volharding\nbelangrijker zijn dan perfectie.', {
            x: 7.2, y: 4.35, w: 5.3, h: 1.0,
            fontFace: F, color: C.muted, fontSize: 12, align: 'center'
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 5 — 02. SPEEDDATING — VRAGEN
        // ════════════════════════════════════════════════════════════════
        let s5 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s5, '02. Speeddating 3e Graad', 'Gesprekken met 5BO & 5ADB');

        card(s5, 0.55, 1.55, W - 1.1, 5.3);

        s5.addText('MIJN 5 VRAGEN', {
            x: 1.1, y: 1.95, w: 11.0, h: 0.35,
            fontFace: F, color: C.muted, fontSize: 12, bold: true, charSpacing: 1
        });

        const questions = [
            'Hoeveel theorie vs. praktijk bevat jullie richting?',
            'Is de wiskunde veel moeilijker dan in het vierde jaar?',
            "Wat houdt de module 'Internationale Handel' concreet in?",
            'Heb je voorkennis nodig voor het programmeren in ADB?',
            'Welke beroepen of hogere studies ambiëren jullie?'
        ];
        questions.forEach((q, i) => {
            let rowY = 2.5 + i * 0.72;
            s5.addText(`0${i + 1}.`, {
                x: 1.1, y: rowY, w: 0.65, h: 0.4,
                fontFace: F, color: C.accentLight, fontSize: 15, bold: true
            });
            s5.addText(q, {
                x: 1.75, y: rowY, w: 10.8, h: 0.4,
                fontFace: F, color: C.white, fontSize: 15
            });
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 6 — BEVINDINGEN SPEEDDATE
        // ════════════════════════════════════════════════════════════════
        let s6 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s6, 'Bevindingen Speeddate');

        // Left: VERRASSEND
        card(s6, 0.55, 1.25, 6.0, 3.9);

        // Small icon circle
        s6.addShape(pptx.ShapeType.ellipse, {
            x: 0.9, y: 1.5, w: 0.65, h: 0.65,
            fill: { color: '1E3A5F' }, line: { type: 'none' }
        });
        s6.addText('🔍', {
            x: 0.9, y: 1.5, w: 0.65, h: 0.65,
            align: 'center', valign: 'middle', fontSize: 16
        });

        s6.addText('VERRASSEND', {
            x: 1.1, y: 1.52, w: 5.1, h: 0.28,
            fontFace: F, color: C.accentLight, fontSize: 11, bold: true, charSpacing: 1
        });
        s6.addText('Grote zelfstandigheid', {
            x: 1.1, y: 1.88, w: 5.1, h: 0.45,
            fontFace: F, color: C.white, fontSize: 18, bold: true
        });
        s6.addText('Veel groepswerken en projecten waarbij leerlingen zelf het voortouw nemen.', {
            x: 1.1, y: 2.42, w: 5.1, h: 1.4,
            fontFace: F, color: C.muted, fontSize: 13
        });

        // Right: BEVESTIGING
        card(s6, 6.88, 1.25, 5.9, 3.9);

        s6.addShape(pptx.ShapeType.ellipse, {
            x: 7.2, y: 1.5, w: 0.65, h: 0.65,
            fill: { color: '1E3A5F' }, line: { type: 'none' }
        });
        s6.addText('✔', {
            x: 7.2, y: 1.5, w: 0.65, h: 0.65,
            align: 'center', valign: 'middle', color: C.success, fontSize: 18
        });

        s6.addText('BEVESTIGING', {
            x: 7.4, y: 1.52, w: 5.0, h: 0.28,
            fontFace: F, color: C.success, fontSize: 11, bold: true, charSpacing: 1
        });
        s6.addText('Wiskunde en logica', {
            x: 7.4, y: 1.88, w: 5.0, h: 0.45,
            fontFace: F, color: C.white, fontSize: 18, bold: true
        });
        s6.addText('De studielast blijft hoog; logisch inzicht (zeker bij ADB) is cruciaal.', {
            x: 7.4, y: 2.42, w: 5.0, h: 1.4,
            fontFace: F, color: C.muted, fontSize: 13
        });

        // Bottom impact banner
        card(s6, 0.55, 5.5, W - 1.1, 1.0, { border: C.accent, borderWidth: 1.2 });
        accentBar(s6, 0.55, 5.5, 1.0, C.accent);
        s6.addText([
            { text: 'Impact op keuze: ', options: { color: C.accentLight, bold: true } },
            { text: 'De praktijkgerichte projecten binnen BO spreken mij het meeste aan.', options: { color: C.white, bold: false } }
        ], {
            x: 0.95, y: 5.75, w: W - 1.7, h: 0.45,
            fontFace: F, fontSize: 14
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 7 — 03. VLOGS & UITSTAPPEN
        // ════════════════════════════════════════════════════════════════
        let s7 = pptx.addSlide({ masterName: 'DARK' });
        sectionLabel(s7, '03. Vlogs & Uitstappen');

        const cols = [
            { icon: '⛵', title: 'HAVENBEZOEK',         desc: 'Inzicht in de logistieke keten en internationale handel.' },
            { icon: '🎤', title: 'GASTSPREKERS',         desc: 'Inspirerende verhalen uit het echte bedrijfsleven.' },
            { icon: '🎬', title: 'VLOGS (NEDERLANDS)',   desc: 'Reflectie en presentatievaardigheden in de praktijk.' }
        ];

        const colW = 3.88, colGap = 0.28;
        cols.forEach((col, idx) => {
            let cx = 0.55 + idx * (colW + colGap);
            card(s7, cx, 1.25, colW, 4.1);

            // Icon circle
            s7.addShape(pptx.ShapeType.ellipse, {
                x: cx + colW / 2 - 0.45, y: 1.55, w: 0.9, h: 0.9,
                fill: { color: '1E3A5F' }, line: { type: 'none' }
            });
            s7.addText(col.icon, {
                x: cx + colW / 2 - 0.45, y: 1.55, w: 0.9, h: 0.9,
                align: 'center', valign: 'middle', fontSize: 22
            });

            s7.addText(col.title, {
                x: cx + 0.2, y: 2.65, w: colW - 0.4, h: 0.38,
                fontFace: F, align: 'center', color: C.white, fontSize: 13, bold: true, charSpacing: 0.5
            });
            s7.addText(col.desc, {
                x: cx + 0.25, y: 3.1, w: colW - 0.5, h: 1.6,
                fontFace: F, align: 'center', color: C.muted, fontSize: 12
            });
        });

        // Quote strip
        card(s7, 0.55, 5.6, W - 1.1, 1.0);
        s7.addText('"De theorie uit de klas werd tastbaar tijdens deze activiteiten."', {
            x: 0.55, y: 5.82, w: W - 1.1, h: 0.52,
            fontFace: F, align: 'center', color: C.white, fontSize: 14, italic: true
        });

        // ════════════════════════════════════════════════════════════════
        // SLIDE 8 — 04. EINDCONCLUSIE
        // ════════════════════════════════════════════════════════════════
        let s8 = pptx.addSlide({ masterName: 'DARK' });

        s8.addText('04. EINDCONCLUSIE', {
            x: 0, y: 0.8, w: W, h: 0.38,
            fontFace: F, align: 'center', color: C.muted, fontSize: 11, bold: true, charSpacing: 2
        });

        // Center card
        const cX = 2.8, cY2 = 1.45, cW2 = 7.7, cH2 = 4.7;
        card(s8, cX, cY2, cW2, cH2);

        s8.addText('MIJN KEUZE VOOR HET 5E JAAR:', {
            x: cX, y: cY2 + 0.45, w: cW2, h: 0.32,
            fontFace: F, align: 'center', color: C.accentLight, fontSize: 11, bold: true, charSpacing: 1
        });
        s8.addText('Bedrijfsorganisatie (BO)', {
            x: cX, y: cY2 + 0.88, w: cW2, h: 0.82,
            fontFace: F, align: 'center', color: C.white, fontSize: 32, bold: true
        });

        // Divider line
        s8.addShape(pptx.ShapeType.rect, {
            x: cX + 0.6, y: cY2 + 2.1, w: cW2 - 1.2, h: 0.02,
            fill: { color: C.mutedDark }, line: { type: 'none' }
        });

        // Reden 1
        s8.addText('REDEN 1', {
            x: cX + 0.6, y: cY2 + 2.3, w: (cW2 - 1.2) / 2 - 0.1, h: 0.27,
            fontFace: F, color: C.muted, fontSize: 10, bold: true, charSpacing: 1
        });
        s8.addText('Match met mijn sterktes', {
            x: cX + 0.6, y: cY2 + 2.62, w: (cW2 - 1.2) / 2 - 0.1, h: 0.36,
            fontFace: F, color: C.white, fontSize: 14, bold: true
        });
        s8.addText('Economie en wiskunde.', {
            x: cX + 0.6, y: cY2 + 3.05, w: (cW2 - 1.2) / 2 - 0.1, h: 0.5,
            fontFace: F, color: C.muted, fontSize: 12
        });

        // Reden 2
        let r2X = cX + 0.6 + (cW2 - 1.2) / 2 + 0.2;
        s8.addText('REDEN 2', {
            x: r2X, y: cY2 + 2.3, w: (cW2 - 1.2) / 2 - 0.1, h: 0.27,
            fontFace: F, color: C.muted, fontSize: 10, bold: true, charSpacing: 1
        });
        s8.addText('Internationale Handel', {
            x: r2X, y: cY2 + 2.62, w: (cW2 - 1.2) / 2 - 0.1, h: 0.36,
            fontFace: F, color: C.white, fontSize: 14, bold: true
        });
        s8.addText('Sterke interesse na havenbezoek.', {
            x: r2X, y: cY2 + 3.05, w: (cW2 - 1.2) / 2 - 0.1, h: 0.5,
            fontFace: F, color: C.muted, fontSize: 12
        });

        // ── EXPORT ──────────────────────────────────────────────────────
        await pptx.writeFile({ fileName: 'Mini-GIP_SJSP_Presentatie.pptx' });

    } catch (err) {
        console.error('Export fout:', err);
        alert('Er ging iets mis bij het genereren van de slides.\n' + err.message);
    } finally {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
    }
}
</script>
